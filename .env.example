# GyroERP Frontend — Environment Variables
# Copy this file to .env.local and fill in values for your environment.
# Variables prefixed VITE_ are exposed to the browser bundle.

# ──────────────────────────────────────────────
# API Configuration
# ──────────────────────────────────────────────

# Base URL of the Django backend (no trailing slash)
# Development: http://localhost:8000
# Production: https://api.yourcompany.com
VITE_API_BASE_URL=http://localhost:8000/api

# WebSocket URL (for future Django Channels integration)
# Development: ws://localhost:8000/ws
# Production: wss://api.yourcompany.com/ws
VITE_WS_URL=ws://localhost:8000/ws

# ──────────────────────────────────────────────
# Application Settings
# ──────────────────────────────────────────────

# App title shown in browser tab and loading screen
VITE_APP_NAME=GyroERP

# App version (injected by CI from package.json)
VITE_APP_VERSION=1.0.0

# ──────────────────────────────────────────────
# Feature Flags
# ──────────────────────────────────────────────

# Enable AI module (requires gyroai backend to be configured)
VITE_FEATURE_AI=true

# Enable dark mode toggle
VITE_FEATURE_DARK_MODE=true

# Enable PWA / service worker (set to false for development)
VITE_FEATURE_PWA=false

# ──────────────────────────────────────────────
# Optional: Analytics / Monitoring
# ──────────────────────────────────────────────

# Sentry DSN for error tracking (leave empty to disable)
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx

# Google Analytics measurement ID (leave empty to disable)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
